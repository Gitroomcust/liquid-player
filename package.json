{
  "name": "liquid-player",
  "version": "1.1.0",
  "description": "Liquid glass music player",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/system-media.js && node --check src/renderer/app.js && node --check src/renderer/viz.js",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "dist": "electron-builder --win --mac --linux"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^42.11.14",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "music-metadata": "^7.14.0"
  },
  "author": "Gitroomcust",
  "homepage": "https://github.com/Gitroomcust/liquid-player",
  "build": {
    "appId": "com.gitroomcust.liquidplayer",
    "productName": "Liquid Player",
    "files": [
      "src/**/*",
      "scripts/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "scripts/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "artifactName": "liquid-player-${version}-${os}-${arch}.${ext}",
    "publish": null,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "liquid-player-${version}-windows-x64-setup.${ext}"
    },
    "portable": {
      "artifactName": "liquid-player-${version}-windows-x64-portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "artifactName": "liquid-player-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSAudioCaptureUsageDescription": "Liquid Player анализирует системный звук, чтобы визуализатор реагировал на любую музыку на компьютере."
      },
      "identity": "-"
    },
    "dmg": {
      "artifactName": "liquid-player-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "AudioVideo",
      "maintainer": "Gitroomcust <alexandrzin2@gmail.com>"
    }
  }
}
